# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.next
# community/ is mostly local-only drafting (WHATSAPP.md, REDDIT.md, welcome copy) and may
# hold future-dated pre-scheduled drafts, which must never be committed to this public repo.
# TELEGRAM.md is the exception: it's post-hoc history only (entries added after a post is
# actually sent), so cloud runs need it tracked to read/append it directly. Future-dated
# Telegram drafts belong in the still-gitignored community/DRAFTS.md until they've gone out.
community/*
!community/TELEGRAM.md
*.tsbuildinfo
next-env.d.ts

# Local-only scripts, but keep the OG card generator (+ its fonts) tracked
scripts/*
!scripts/og/

# Generated OG social cards (rebuilt by `pnpm og` and the build step)
/public/og/

# Google Search Console skill: never commit the service-account key or the local DB
# (the skill's SKILL.md and gsc-sync.tsx stay tracked)
.claude/skills/google-search-console/gsc-credentials.json
.claude/skills/google-search-console/gsc-data.sqlite
.claude/skills/google-search-console/gsc-data.sqlite-*

# DataForSEO SERP skill: kept entirely local — scripts, index and raw-response
# archive alike. Credentials live in .env.local, already ignored below.
.claude/skills/dataforseo-serp/
.vercel
.env*
